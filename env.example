# Required for SEC requests. Use your real contact email.
SEC_USER_AGENT=StockSignal/0.3 your-email@example.com

# Personal login. Leave blank locally if you do not want a login screen.
APP_PASSWORD=
APP_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false

# Local default. For production, use a persistent PostgreSQL database when ready.
DATABASE_URL=sqlite:///./stock_signal.db

# Optional providers
X_BEARER_TOKEN=
NEWSAPI_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
